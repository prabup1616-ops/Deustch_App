{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "🚀 Run Streamlit Server",
            "type": "shell",
            "command": "python -m streamlit run app.py --server.port 8501",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "🧪 Check Syntax & Compile All Files",
            "type": "shell",
            "command": "python -m py_compile app.py storage.py src/ai_service.py src/lsrw_cache.py src/views/*.py src/components/*.py",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always"
            }
        },
        {
            "label": "🔄 Regenerate Pronoun Questions",
            "type": "shell",
            "command": "python generate_questions.py",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always"
            }
        },
        {
            "label": "🔄 Regenerate Gender Questions",
            "type": "shell",
            "command": "python generate_gender_questions.py",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always"
            }
        },
        {
            "label": "📦 Git Push to Main (Streamlit Cloud Deploy)",
            "type": "shell",
            "command": "git add -A && git commit -m \"deploy: updates via VS Code\" && git push origin main",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always"
            }
        }
    ]
}
